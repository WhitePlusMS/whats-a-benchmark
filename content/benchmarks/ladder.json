  "officialDefinition": {
    "summary": "评估机器人在长步骤操作中完成多个目标的能力。",
    "task": "在指定场景中按语言目标操作多个物体，完成一至十个子目标。",
    "sourceUrls": [
      "https://arxiv.org/abs/2610.18053",
      "https://github.com/insait-institute/ladder"
    ]
  },
  "taskContract": {
    "input": "任务指令及仿真环境中的视觉、机器人状态；具体信息依方法和套件而定。",
    "output": "机器人操作轨迹，使任务的全部子目标和约束在结束时成立。",
    "environment": "三套仿真环境分别为 SimplerEnv-Long、RobotArena-∞-Long 和 RoboLab-Long；论文另在真实 WidowX 和 Franka 上测试部分任务与方法。",
    "sourceUrls": [
      "https://arxiv.org/abs/2610.18053",
      "https://github.com/insait-institute/ladder"
    ]
  },
