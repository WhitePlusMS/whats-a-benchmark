  "officialDefinition": {
    "summary": "Chatbot Arena 是由 LMSYS 维护的在线匿名人类偏好评测平台，访客比较两个模型回复并可提交投票。",
    "task": "同一用户提示下匿名展示两个模型回答，由用户选择偏好或平局；不同历史数据快照是平台数据发布，不构成固定题库。",
    "sourceUrls": [
      "https://arena.ai/blog/arena#introduction"
    ]
  },
  "taskContract": {
    "input": "用户提交的自然语言提示及候选模型回复。",
    "output": "用户投票的偏好标签，通常为左侧胜、右侧胜或平局。",
    "environment": "在线平台按其当期匹配、隐私和投票流程运行；历史数据集快照不等于平台全部实时对话。",
    "sourceUrls": [
      "https://arena.ai/blog/arena#introduction",
      "https://huggingface.co/datasets/lmsys/chatbot_arena_conversations"
    ]
  },
  "dataProfile": {
    "summary": "平台持续产生投票与对话数据；公开数据集是特定历史快照，数量和许可按发布版本区分。",
    "disclosure": "partial",
    "scale": [
      "历史公开对话集约 33K 条，来自早期快照。",
      "arena-human-preference-55k 发布版约 57.5K 条对话；二者为不同快照。"
    ],
    "splits": [
      "55k 发布集标注为单一 train split；这不是 Arena 平台的统一评测划分。"
    ],
    "fields": [
      "历史对话记录包含模型、提示、回复与偏好标签等字段；精确 schema 随数据集版本变化。"
    ],
    "files": [
      "公开发布的 33K 与 55K 快照分别托管于 Hugging Face；不等同于平台实时完整数据库。"
    ],
    "sourceUrls": [
      "https://huggingface.co/datasets/lmsys/chatbot_arena_conversations",
      "https://huggingface.co/datasets/lmarena-ai/arena-human-preference-55k"
    ]
  },
