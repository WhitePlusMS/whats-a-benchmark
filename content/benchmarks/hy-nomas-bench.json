  "officialDefinition": {
    "summary": "评估视频世界模型在连续交互中跟随文本、移动相机和保持空间一致性的能力。",
    "task": "按顺序重放同一场景的控制请求，生成连续的多轮视频。",
    "sourceUrls": [
      "https://huggingface.co/datasets/tencent/Hy-Nomas-Bench/blob/d9de365b6cbec9869026709de64c42833062b961/README.md",
      "https://arxiv.org/html/2610.36729v1#S7"
    ]
  },
  "taskContract": {
    "input": "按评测组接收初始场景、后续文本请求、相机按键或参考轨迹。",
    "output": "同一场景随多轮输入延续的视频片段；不同轮次不能彼此独立生成后直接比较。",
    "environment": "使用模型自身支持的交互接口；按论文记录提示词表示、运行设置及未纳入的组。",
    "sourceUrls": [
      "https://huggingface.co/datasets/tencent/Hy-Nomas-Bench/blob/d9de365b6cbec9869026709de64c42833062b961/README.md",
      "https://arxiv.org/html/2610.36729v1#S7"
    ]
  },
  "dataProfile": {
    "summary": "四组均为公开 test；发布包提供输入和参考相机几何，不是训练集或评分结果。",
    "disclosure": "complete",
    "scale": [
      "多轮文本 60；相机导航 100；文本与相机交替 60；空间记忆 60；共 280。"
    ],
    "splits": [
      "四个独立的 test 配置，各自对应同名 JSON。"
    ],
    "fields": [
      "test_id、total_duration、segments；按组另有 user_prompts 或 camera_trajectory_spec。"
    ],
    "files": [
      "每组含任务 JSON 和 benchmark_config.json；相机相关三组另有 NPZ 参考轨迹。"
    ],
    "sourceUrls": [
      "https://huggingface.co/datasets/tencent/Hy-Nomas-Bench/blob/d9de365b6cbec9869026709de64c42833062b961/README.md"
    ]
  },
