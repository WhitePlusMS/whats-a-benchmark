  "officialDefinition": {
    "summary": "τ²-bench 将代理和用户建模为 Dec-POMDP 中的两个参与方。用户除了通过语言提供目标或偏好，也能调用受限工具改变自己的设备状态；代理必须诊断问题、指导用户、调用自己的业务工具，并共同达到可程序化验证的最终状态。论文还给出 no-user 等消融设置，用于分辨自主推理和人机协调的影响。",
    "task": "在 dual-control 设置中，代理和模拟用户协同操作共享环境，达到可程序化验证的目标状态。",
    "sourceUrls": [
      "https://arxiv.org/html/2506.07982v1",
      "https://arxiv.org/abs/2506.07982v1"
    ]
  },
  "taskContract": {
    "input": "领域政策、任务场景/用户指令、双方可用工具及 mock 数据库。",
    "output": "多轮对话、双方工具轨迹及共享环境最终状态。",
    "environment": "任务按领域组合数据库检查、状态/语言断言、沟通要求或动作匹配；复现须固定 agent、user simulator、任务版本和 trial 数。",
    "sourceUrls": [
      "https://arxiv.org/html/2506.07982v1",
      "https://github.com/sierra-research/tau2-bench",
      "https://arxiv.org/abs/2506.07982v1"
    ]
  },
