  "officialDefinition": {
    "summary": "LongBench v2 是 THUDM 发布的长上下文理解与推理基准，包含六类真实长上下文任务，并与 LongBench v1 的任务集和统计口径分开。",
    "task": "模型基于长文档、对话、代码仓库或结构化材料回答多项选择题。",
    "sourceUrls": [
      "https://github.com/THUDM/LongBench",
      "https://huggingface.co/datasets/THUDM/LongBench-v2"
    ]
  },
  "taskContract": {
    "input": "问题、四个选项和所需长上下文；上下文可为文档、书籍或代码仓库。",
    "output": "从 A、B、C、D 中选择一个答案。",
    "environment": "主要是给定上下文的静态问答；作者代码可配置直接推理、CoT、无上下文对照或检索增强，报告需注明设置和上下文窗口。",
    "sourceUrls": [
      "https://github.com/THUDM/LongBench#data-format",
      "https://huggingface.co/datasets/THUDM/LongBench-v2",
      "https://github.com/THUDM/LongBench"
    ]
  },
