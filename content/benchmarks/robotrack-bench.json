  "officialDefinition": {
    "summary": "在真实机器人操作等视频中跟踪查询点，检验定位和遮挡判断。",
    "task": "给定一段视频和已标定的查询点，预测后续逐帧坐标与可见性。",
    "sourceUrls": [
      "https://allenai.org/blog/robotrack",
      "https://huggingface.co/datasets/allenai/RoboTrack-Bench/resolve/bb275295d5f616260df87dda32f0362108736340/README.md"
    ]
  },
  "taskContract": {
    "input": "操作视频片段及各点首次可见帧的位置。",
    "output": "查询点在后续帧的二维位置与是否可见。",
    "environment": "运行离线点跟踪和逐段评分，不向机器人发控制指令。",
    "sourceUrls": [
      "https://huggingface.co/datasets/allenai/RoboTrack-Bench/resolve/bb275295d5f616260df87dda32f0362108736340/README.md",
      "https://raw.githubusercontent.com/allenai/robotrack/fc5cd87f60fad57c7cbc48c3d09e9aa7b45061a3/robotrack/metrics.py"
    ]
  },
  "dataProfile": {
    "summary": "正式评测含 307 段视频与 2,522 条点轨迹；不是 RoboTrack-15M 训练集。",
    "disclosure": "complete",
    "scale": [
      "公开 metadata.jsonl 有 265 段；另 42 段 Ego-Exo4D 视频需从上游另取。"
    ],
    "splits": [
      "RoboTrack-Bench 是评测集；RoboTrack-15M 是另行发布的合成训练数据。"
    ],
    "fields": [
      "视频来源、设备形态、帧数、点数，以及 NPZ 中的二维轨迹、可见性和查询帧。"
    ],
    "files": [
