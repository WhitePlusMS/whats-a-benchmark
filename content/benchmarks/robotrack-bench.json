  "metric": {
    "name": "平均 Jaccard（AJ）",
    "description": "只评分各点查询帧之后；以归一化到 256×256 后的 1、2、4、8、16 像素距离阈值综合定位与可见性。另报位置准确率和遮挡准确率；逐段计算后等权平均。",
    "direction": "higher",
    "sourceUrls": [
      "https://raw.githubusercontent.com/allenai/robotrack/fc5cd87f60fad57c7cbc48c3d09e9aa7b45061a3/robotrack/metrics.py",
