  "officialDefinition": {
    "summary": "C-Eval 以中文考试式选择题评估模型在 STEM、社会科学、人文与其他领域的知识和推理能力。",
    "task": "针对中文题干，从 A–D 选项中选择答案；部分 split 另含解释。",
    "sourceUrls": [
      "https://github.com/hkust-nlp/ceval",
      "https://arxiv.org/abs/2305.08322"
    ]
  },
  "taskContract": {
    "input": "中文选择题题干与 A–D 四个选项。",
    "output": "单个选项答案，数据字段还包括 id 与 explanation。",
    "environment": "官方基线包含 zero-shot 与 five-shot；dev 用作示例、val 用于开发，test 用于评测。无交互式 agent 环境。",
    "sourceUrls": [
      "https://github.com/hkust-nlp/ceval#data",
      "https://github.com/hkust-nlp/ceval#leaderboard"
    ]
  },
  "dataProfile": {
    "summary": "官方仓库报告 13,948 道题，覆盖 52 个学科与四个难度层级。",
    "disclosure": "partial",
    "scale": [
      "总量 13,948 道选择题，覆盖 52 个学科与四个难度层级。",
      "每个学科的 dev split 含 5 道示例；官方报告 val 共 1,346 道。"
    ],
    "splits": [
      "按学科组织 dev、val、test 三个 split。",
      "README 旧说明称 test 标签不公开，而 2025-07 公告及当前 Hugging Face 页面显示 test 数据已发布；核验时点和仓库版本需一并记录。"
    ],
    "fields": [
      "CSV 行包含 id、question、A、B、C、D、answer 和 explanation。",
      "subject_mapping.json 提供主题英文名、中文名与大类映射。"
    ],
    "files": [
      "官方仓库提供按主题组织的 CSV、数据压缩包和 subject_mapping.json。",
      "Hugging Face 发布为 ceval/ceval-exam 数据集。"
