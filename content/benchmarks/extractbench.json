  "officialDefinition": {
    "summary": "评测模型能否从企业 PDF 按给定结构提取全部所需记录，返回可在原页核对的证据。包含扫描、手写、跨页表格和各种业务文档。",
    "task": "读同一份 PDF 和字段定义，生成符合 JSON Schema 的结构化值；有核验标注时，还可以定位来源页和区域。",
    "sourceUrls": [
      "https://www.extractbench.ai/",
      "https://huggingface.co/datasets/llamaindex/ExtractBench/blob/f9b910906cd7e73cc9eb5379a8d5d935c67b92c4/README.md",
      "https://arxiv.org/abs/2607.29677v1"
    ]
  },
  "taskContract": {
    "input": "原始 PDF 和对应 JSON Schema。不同文档的字段及列表结构不同。",
    "output": "符合该题 JSON Schema 的结果 JSON，按需附上字段的依据页和证据框；不只是生成摘要。",
    "environment": "评测使用作者的确定性 scorer，对齐预测与参考值，不让另一个模型评判。",
    "sourceUrls": [
      "https://www.extractbench.ai/",
      "https://huggingface.co/datasets/llamaindex/ExtractBench/blob/f9b910906cd7e73cc9eb5379a8d5d935c67b92c4/README.md",
      "https://arxiv.org/abs/2607.29677v1"
    ]
  },
  "dataProfile": {
    "summary": "基础版包含 370 组文档与提取结构，按文档页数分三组；固定记录附参考值和评分证据。",
    "disclosure": "complete",
    "scale": [
      "370 份文档、4,869 页；325 份原始文档、45 份作者标为 synthetic 的长列表。"
    ],
    "splits": [
      "short：252 条，最多 10 页",
      "medium：98 条，11–50 页",
      "long：20 条，超过 50 页"
    ],
