  "officialDefinition": {
    "summary": "BenchCAD 将视觉 CAD 生成、CAD 编辑和 CAD 问答任务结合起来，评估模型理解工程图像并生成或修改可执行 CadQuery 代码的能力。",
    "task": "基准包含 Vision2Code、CodeEdit、Vision-QA 和 Code-QA 四种任务模式。",
    "sourceUrls": [
      "https://github.com/BenchCAD/BenchCAD-main#tasks",
      "https://github.com/BenchCAD/BenchCAD-main#dataset"
    ]
  },
  "taskContract": {
    "input": "按任务模式提供工程图像、CadQuery 源码或工程问题。",
    "output": "生成或修改后的 CadQuery 程序，或 QA 文本答案；代码任务可通过执行与几何检查评分。",
    "environment": "官方实现使用 Python 3.11 与 uv；数据分为 code_gen、edit-bench、QA 配置，静态视觉/代码任务无交互式仿真器。",
    "sourceUrls": [
      "https://github.com/BenchCAD/BenchCAD-main#installation",
      "https://github.com/BenchCAD/BenchCAD-main#dataset"
    ]
  },
  "dataProfile": {
    "summary": "BenchCAD 汇集执行验证的 CadQuery 程序、编辑任务与 QA 数据；不同任务配置使用各自规模。",
    "disclosure": "complete",
    "scale": [
      "code_gen：17,900 个程序。",
      "edit-bench：748 个编辑样例；QA：2,400 个数值问题。",
      "数据覆盖 106 个零件族和 47 项工程标准。"
    ],
    "splits": [
      "Hugging Face 分为 code_gen、edit-bench、QA 三个配置。",
      "当前 QA 配置显示一个 split；官方没有统一声明跨配置的 train/test 划分。"
    ],
    "fields": [
      "记录字段包括 record_id、stem、family、CadQuery code 与视图信息。",
      "QA 对象包含 question、answer、type、source 和 level。"
    ],
    "files": [
      "主数据由 BenchCAD Hugging Face 配置提供。",
      "公开仓库另有 QA/test_data/records.jsonl 小型 QA 文件。"
