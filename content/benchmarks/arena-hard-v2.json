  "officialDefinition": {
    "summary": "Arena-Hard v2.0 是从真实用户对话中筛选的高难度提示集，使用 LLM judge 评估模型相对参考模型的回答质量。",
    "task": "模型回答给定用户提示，再由 judge 与目标模型回答比较；榜单以偏好胜率呈现。",
    "sourceUrls": [
      "https://github.com/lmarena/arena-hard-auto#about"
    ]
  },
  "taskContract": {
    "input": "用户提示及指定的目标模型对话上下文。",
    "output": "对提示的文本回答；judge 将候选回答与目标模型回答进行比较。",
    "environment": "基于 Arena-Hard auto-eval 脚本运行；必须记录被比较模型、judge 模型与采样配置。",
    "sourceUrls": [
      "https://github.com/lmarena/arena-hard-auto#about"
    ]
  },
  "dataProfile": {
    "summary": "v2.0 提供 750 个提示：500 个 hard prompts 和 250 个 creative-writing prompts。",
    "disclosure": "complete",
    "scale": [
      "500 个 hard prompts。",
      "250 个 creative-writing prompts；合计 750 个提示。"
    ],
    "splits": [
      "官方未声明 train/dev/test 划分；公开题目用于评测。"
    ],
    "fields": [
      "题目记录包含 uid、category、subcategory 与 prompt。"
    ],
    "files": [
      "官方题目文件位于 data/arena-hard-v2.0/question.jsonl。",
      "结果数据另有公开仓库或 Hugging Face 发布；与题目 JSONL 分开。"
    ],
    "sourceUrls": [
