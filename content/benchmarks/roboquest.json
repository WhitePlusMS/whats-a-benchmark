  "officialDefinition": {
    "summary": "评估机器人为获取信息而主动搜索、检查和实验的能力。",
    "task": "主动搜索、检查或试验以获取隐藏信息，再执行移动操作并决定何时提交结果。",
    "sourceUrls": [
      "https://declare-lab.github.io/RoboQuest/",
      "https://arxiv.org/abs/2610.10388"
    ]
  },
  "taskContract": {
    "input": "移动操作任务指令与相机观测；目标位置、容器打开方式等关键信息可能在初始时隐藏。",
    "output": "通过移动、搜索、检查和物体操作收集所需信息并完成任务，最后使用 SUBMIT 结束该次尝试。",
    "environment": "在 RoboCasa365 的 MuJoCo 厨房仿真中，使用移动底盘与 Franka Panda 机械臂；初始观测不暴露完成任务所需的全部信息。",
    "sourceUrls": [
      "https://declare-lab.github.io/RoboQuest/",
      "https://arxiv.org/abs/2610.10388"
    ]
  },
  "dataProfile": {
    "summary": "10 个移动操作任务，覆盖搜索、检查与交互测试。",
    "disclosure": "partial",
