  "officialDefinition": {
    "summary": "在 GIFT-Eval 留出测试窗口上，评估预测器能否把结构化未来信息转换为数值预测。",
    "task": "以历史序列和宏观、微观效果信息预测未来轨迹。",
    "sourceUrls": [
      "https://arxiv.org/html/2610.17794"
    ]
  },
  "taskContract": {
    "input": "历史序列及由真实未来派生的 Macro 和 Micro 结构化效果。",
    "output": "与指定预测长度一致的未来数值序列。",
    "environment": "结构化效果由真实未来反向派生，衡量的是给定未来信息时的条件预测，不可直接等同无未来信息的预测。",
    "sourceUrls": [
      "https://arxiv.org/html/2610.17794"
    ]
  },
  "dataProfile": {
    "summary": "作者公开 test 分区 10,000 条真实实例及预测结果；固定版文件已下载并读取。",
    "disclosure": "partial",
    "scale": [
      "10,000 个实例，来自 20 个数据源，78 个数据集—频率—预测长度配置。",
      "短、中、长实例分别为 6,559、2,135、1,306；共有 23,476 个 Micro 效果。"
    ],
    "splits": [
      "实例来自原 GIFT-Eval 的 held-out test 区域。"
    ],
    "fields": [
      "dataset、term、item_id、window_id、history、future、n_history、n_horizon、frequency、tsfm_average_forecast、macro、micro"
    ],
    "files": [
