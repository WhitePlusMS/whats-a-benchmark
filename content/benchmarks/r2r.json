  "officialDefinition": {
    "summary": "评估导航智能体在真实建筑扫描构成的环境中，依据自然语言路线指令到达目标。",
    "task": "智能体根据人类编写的路线指令和沿途视觉观察，在室内导航图中移动并在目标附近停止。",
    "sourceUrls": [
      "https://bringmeaspoon.org/"
    ]
  },
  "taskContract": {
    "input": "自然语言路线指令、起始位置和朝向，以及当前位置的视觉观察。",
    "output": "在可导航视点之间移动并决定何时停止，产生从起点到终点的导航轨迹。",
    "environment": "Matterport3D 建筑扫描组成的离散视点仿真环境；val_seen 与 val_unseen 分别检查已见和未见建筑中的泛化。",
    "sourceUrls": [
      "https://github.com/peteanderson80/Matterport3DSimulator/blob/master/tasks/R2R/README.md",
      "https://arxiv.org/abs/1711.07280"
    ]
  },
  "dataProfile": {
    "summary": "原论文描述 7,189 条路径和 21,567 条自然语言指令，覆盖 90 个建筑场景。",
    "disclosure": "partial",
    "scale": [
      "原论文描述 7,189 条路径和 21,567 条自然语言指令，覆盖 90 个建筑场景。"
    ],
    "splits": [
      "train：训练路径；val_seen：训练中出现过的建筑中的验证路径。",
      "val_unseen：训练时未见建筑中的验证路径；test：未见建筑中的测试路径。",
      "本站下载文件包含 val_seen 340 条路径和 val_unseen 783 条路径；前者 339 条各有三条指令、1 条有四条，后者每条均有三条指令。"
    ],
    "fields": [
      "scan 为场景标识；path 为视点标识序列；heading 为初始朝向；distance 为路径距离；instructions 为路径对应的自然语言描述。"
    ],
    "files": [
      "官方脚本分别提供 train、val_seen、val_unseen 和 test JSON 文件。"
    ],
    "sourceUrls": [
