  "officialDefinition": {
    "summary": "Artificial Analysis 基于 OpenAI GDPval 的公开 gold 子集建立了 GDPval-AA，并用自己的 Stirrup agent 环境和成品盲评协议报告结果。它是独立的第三方评测，不等同于 OpenAI GDPval。",
    "task": "模型在 Stirrup agent 环境中完成 GDPval 职业任务，提交工作成品；AA 对不同模型的成品进行匿名成对比较并汇总 Elo。",
    "sourceUrls": [
      "https://artificialanalysis.ai/evaluations/gdpval-aa#L13-L23",
      "https://artificialanalysis.ai/methodology/intelligence-benchmarking"
    ]
  },
  "taskContract": {
    "input": "公开 GDPval gold 任务提示及该任务的参考文件。",
    "output": "一个或多个符合任务要求的工作成品文件，如文档、演示文稿、图表或表格。",
    "environment": "AA Stirrup agent、shell、网页浏览和隔离沙箱；方法页记录每题运行一次，模型版本与推理设置随榜单条目区分。",
    "sourceUrls": [
      "https://huggingface.co/datasets/openai/gdpval",
      "https://artificialanalysis.ai/evaluations/gdpval-aa",
      "https://artificialanalysis.ai/evaluations/gdpval-aa#L271-L276",
      "https://artificialanalysis.ai/methodology/intelligence-benchmarking#L85-L87"
    ]
  },
  "dataProfile": {
