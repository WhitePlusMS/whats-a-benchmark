  "officialDefinition": {
    "summary": "用 30 项沟通特质衡量模型回答风格，并汇总为 8 个风格指数；不是通用能力或人格优劣排名。",
    "task": "对同一提示的不同模型回答进行盲评，判断哪份更体现指定特质，允许平局。",
    "sourceUrls": [
      "https://artificialanalysis.ai/methodology/aa-personalitybench",
      "https://artificialanalysis.ai/articles/aa-personalitybench"
    ]
  },
  "taskContract": {
    "input": "每项特质 30 道问题；仅用户提示，没有 system prompt。",
    "output": "每个模型每题一次回答，再做匿名成对特质比较。",
    "environment": "随机回答顺序、平衡评委分配；评委面板为 Gemini 3.8 Flash（high）、Claude Sonnet 5.5（medium）、GLM-5.3 Flash（max）。",
    "sourceUrls": [
      "https://artificialanalysis.ai/methodology/aa-personalitybench"
    ]
  },
  "dataProfile": {
    "summary": "30 特质 × 30 问题 = 900 问题；完整问题集私有，官方展示 5 个公开例子；另统计 21 项程序化沟通特征。",
    "disclosure": "partial",
    "scale": [
      "8 指数：Expressiveness、Organization、Informativeness、Transparency、Warmth、Conviction、Imagination、Slop。",
      "21 项程序化特征涵盖长度、结构、标点与强调方式。"
    ],
