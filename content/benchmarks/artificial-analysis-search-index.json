  "officialDefinition": {
    "summary": "固定答题模型和评测任务，更换搜索 API；等权汇总三项问答质量指标。",
    "task": "比较同一个智能体配接不同搜索 API 时的回答质量，另以同模型不搜索的一次作答作基线。",
    "sourceUrls": [
      "https://artificialanalysis.ai/articles/search-api",
      "https://artificialanalysis.ai/methodology/search-api"
    ]
  },
  "taskContract": {
    "input": "三个组成集各自的检索或事实问题；指数不另出题。常规供应商通过检索与网页读取工具提供外部信息。",
    "output": "提交单个答案或答案集合，由该组成项的规则判分；Stirrup 流程未在 25 轮内提交最终答案则计零。",
    "environment": "常规供应商使用固定 GPT-5.6 Luna（medium）与 Stirrup，最多 25 轮，搜索每次最多 10 条结果。无搜索基线直接单次作答；榜单另列使用 OpenAI 自带搜索工具的一次调用，不走 Stirrup。",
    "sourceUrls": [
      "https://artificialanalysis.ai/methodology/search-api",
      "https://artificialanalysis.ai/agents/search-api"
    ]
  },
  "dataProfile": {
    "summary": "使用完整公开 DeepSearchQA eval（900 题）、私有 AA-Omniscience（600 题）和 BrowseComp 困难子集（200 题）。",
    "disclosure": "partial",
    "scale": [
      "DeepSearchQA：900 题；AA-Omniscience：6 个领域各 100 题；BrowseComp：从 1,266 题中取困难的 200 题。"
