  "officialDefinition": {
    "summary": "AutomationBench 评估智能体在模拟 Zapier 应用中根据事件触发器和用户目标完成自动化工作流的能力。",
    "task": "Agent 根据 trigger 和 initial state 调用模拟应用工具，完成用户目标并满足预设 assertions。",
    "sourceUrls": [
      "https://github.com/zapier/AutomationBench/blob/main/README.md#how-it-works"
    ]
  },
  "taskContract": {
    "input": "任务的触发条件、初始应用状态、可用工具和目标描述。",
    "output": "一组工具调用及最终应用状态；测试 assertions 判断工作流是否达成目标。",
    "environment": "官方仓库提供模拟集成环境和公开任务；榜单 private split 由官方单独保留。",
    "sourceUrls": [
      "https://github.com/zapier/AutomationBench/blob/main/README.md"
    ]
  },
  "dataProfile": {
    "summary": "公开仓库包含 600 个计分任务与 200 个 simple 基础任务；官方榜单还保留 private 任务。",
