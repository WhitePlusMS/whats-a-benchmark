    "scale": [
      "六个计分领域各 100 项，共 600 个公开任务。",
      "simple 域另有 200 个单步或双步任务，不纳入正式分数。"
    ],
    "splits": [
      "公开任务按 Sales、Marketing、Operations、Support、Finance、HR 组织。",
      "官方榜单的 private split 与公开仓库任务分开。"
