  "officialDefinition": {
    "summary": "OfficeQA Pro 衡量模型或代理能否在真实、密集的美国财政部公报中找到并组合财务表格、图表和正文证据，完成端到端文档推理。问题需基于 1939–2025 年 Treasury Bulletin 语料作答；它测试检索、工具使用和多步计算/推理。",
    "task": "从 Treasury Bulletin 中检索并组合财务表格、图表和正文证据，回答多步文档推理问题。",
    "sourceUrls": [
      "https://huggingface.co/datasets/databricks/officeqa",
      "https://github.com/databricks/officeqa"
    ]
  },
  "taskContract": {
    "input": "问题及 Treasury Bulletin PDF、解析 JSON 或转写文本语料。",
    "output": "数值、货币或标签/数值答案。",
    "environment": "官方提供端到端 Agent Harness 和给定 oracle pages 的 LLM+网页搜索设置；两种结果应分开报告，并注明工具、解析方式和容差。",
    "sourceUrls": [
      "https://github.com/databricks/officeqa",
      "https://huggingface.co/datasets/databricks/officeqa"
    ]
  },
  "dataProfile": {
    "summary": "OfficeQA Pro 使用 1939–2025 年 Treasury Bulletin 语料；题目与答案集需申请访问。",
    "disclosure": "partial",
    "scale": [
      "Pro 133 题；Full 246 题（133 hard、113 easy）；共享 697 期公报语料。"
    ],
    "splits": [
      "Pro CSV 使用 train；OfficeQA Full 是独立变体，不是 Pro 的 split。"
    ],
    "fields": [
      "uid、question、answer、source_docs、source_files、difficulty。"
    ],
