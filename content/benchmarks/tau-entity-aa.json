  "officialDefinition": {
    "summary": "衡量语音代理能否准确收集缺失字段，并在常规和受扰语音下稳定写对。",
    "task": "通过回拨向模拟用户收集一个缺失的值，并写回对应字段。",
    "sourceUrls": [
      "https://artificialanalysis.ai/methodology/speech-to-speech-benchmarking#agentic-performance-tau-voice",
      "https://arxiv.org/html/2609.13602v1#S1.F1"
    ]
  },
  "taskContract": {
    "input": "英语模拟回拨、缺字段的虚构记录和提交字段的工具。模拟场景有诊所、汽车服务和酒店。",
    "output": "在通话中获得值，在后台写入规范格式的精确字段。",
    "environment": "每题分别在常规、重信道噪声、重语音扰动下运行一次；GPT-5.5（低推理）与 ElevenLabs eleven_v3 模拟通话人，每通最多 240 秒。",
    "sourceUrls": [
      "https://artificialanalysis.ai/methodology/speech-to-speech-benchmarking#agentic-performance-tau-voice",
      "https://github.com/sierra-research/tau2-bench/blob/989d3285ae669e49503324bdb9981bf14fccedeb/data/tau2/benchmarks/entity.json"
    ]
  },
  "dataProfile": {
