  "officialDefinition": {
    "summary": "评估人形机器人在家庭任务上的全身移动、双臂操作与程序控制。",
    "task": "控制人形机器人底盘、双臂和夹爪，完成指定家庭任务。",
    "sourceUrls": [
      "https://bigym2.github.io/",
      "https://bigym2.github.io/docs/"
    ]
  },
  "taskContract": {
    "input": "例如 move_plate：三路 84×84 RGB 相机观测和 50 维低维状态；不同任务配置可能不同。",
    "output": "策略输出动作，控制底盘、14 个手臂关节和两个夹爪；下肢由冻结的 GR00T-WBC 控制。",
    "environment": "MuJoCo 中的 Unitree G1，GR00T-WBC 控制下肢；策略控制底盘、双臂与夹爪。",
    "sourceUrls": [
      "https://bigym2.github.io/",
      "https://bigym2.github.io/docs/"
    ]
  },
  "dataProfile": {
    "summary": "20 项家庭任务；论文对比 9 项核心任务，另有 11 项扩展任务。",
    "disclosure": "partial",
    "scale": [
      "20 项家庭任务；论文对比 9 项核心任务，另有 11 项扩展任务。"
    ],
    "splits": [
      "每项任务有 60 条人工 VR 示范；官方评测使用 100 个种子 620000–620099。",
      "公开的 coding-agent 轨迹覆盖 2 个智能体、9 项任务、每项 3 次会话，共 5,400 次评测；并非全部任务和智能体的轨迹。"
    ],
    "fields": [
      "评测清单含任务、会话、模型、种子、成功标记、步数与轨迹路径。",
      "轨迹 NPZ 包含仿真状态与动作；本身不包含图像。"
    ],
