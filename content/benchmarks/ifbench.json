  "metric": {
    "name": "Prompt-level loose accuracy",
    "description": "论文通常报告 prompt-level loose accuracy；官方代码另支持 strict/loose 及 prompt-level/instruction-level 聚合。thinking 模型可使用不同 token 上限，评分前会提取最终答案，因此发布成绩应标记所用口径和生成设置。",
    "direction": "higher",
    "sourceUrls": [
      "https://github.com/allenai/IFBench/blob/main/README.md",
      "https://arxiv.org/abs/2507.02833"
    ]
  },
  "limitations": [
    {
      "text": "模型厂商成绩表可能省略 strict/loose、温度和 thinking token 上限，比较前需查完整设置。",
