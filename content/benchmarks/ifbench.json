  ],
  "researchStatus": "pass-with-limitations",
  "officialDefinition": {
    "summary": "IFBench 是 Ai2 发布的精确指令遵循评测，测试 58 个新的分布外约束及其 verifier，并提供可选的双轮约束隔离设置。",
    "task": "给定 prompt 与约束生成回答，由对应规则验证器检查回答是否符合约束；评估可按 prompt 或 instruction 及 strict/loose 模式聚合。",
    "sourceUrls": [
      "https://github.com/allenai/IFBench/blob/main/README.md",
      "https://arxiv.org/abs/2507.02833"
    ]
  },
  "taskContract": {
    "input": "官方 IFBench_test.jsonl prompt/约束及模型回复 JSONL；多轮变体将原始 prompt 和后续约束分两轮提交。",
    "output": "规则 verifier 对生成回复的逐项结果，以及 prompt-level 或 instruction-level 准确率聚合。",
    "environment": "使用 Ai2 官方 Python 仓库或 ifbench 包；评估设置包括 temperature 0，并按模型类型设置最大生成 token。",
    "sourceUrls": [
      "https://github.com/allenai/IFBench/blob/main/README.md"
    ]
  },
  "dataProfile": {
    "summary": "测试部分由 58 个 OOD constraint 类型构成；官方另发多轮测试和 IF-RLVR 训练数据。",
    "disclosure": "partial",
    "scale": [
      "58类OOD测试约束及相应验证函数；当前HF公开测试发布包含300条prompt记录，两种计数单位不同。",
      "IF-RLVR另有29类训练约束，不与IFBench测试约束或测试题数相加。"
    ],
    "splits": [
      "官方提供单轮测试、多轮约束隔离设置及独立IF-RLVR训练资源；HF IFBench_test的当前文件标签为train（300行），不把存储标签当作模型训练协议。"
    ],
    "fields": [
      "公开测试输入：key、prompt、instruction_id_list、kwargs；kwargs保存各约束参数。",
      "模型回复文件中的prompt/completion与上述测试输入schema分别说明。"
    ],
    "files": [
      "测试文件名为 IFBench_test.jsonl；示例回复文件名为 sample_output.jsonl。"
    ],
    "sourceUrls": [
      "https://github.com/allenai/IFBench/blob/main/README.md",
      "https://huggingface.co/datasets/allenai/IFBench_test",
      "https://huggingface.co/api/datasets/allenai/IFBench_test",
      "https://raw.githubusercontent.com/allenai/IFBench/main/README.md"
    ]
  },
