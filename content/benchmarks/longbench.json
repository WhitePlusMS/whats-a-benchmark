  "officialDefinition": {
    "summary": "通过中英文长文本任务评估模型的长上下文理解能力，覆盖单文档和多文档问答、摘要、少样本学习、合成任务及代码补全；各任务使用相应的自动评分方法。",
    "task": "根据长上下文完成问答、摘要、少样本、合成或代码补全等任务，按数据集使用各自评分指标。",
    "sourceUrls": [
      "https://github.com/THUDM/LongBench/tree/main/LongBench",
      "https://arxiv.org/abs/2308.14508",
      "https://github.com/THUDM/LongBench/blob/main/LongBench/README.md"
    ]
  },
  "taskContract": {
    "input": "任务指令或问题、长上下文以及特定任务所需的类别或选项信息。",
    "output": "任务指定的生成文本、答案或类别；各任务使用适配指标。",
    "environment": "静态长文本输入/输出；仓库提供 zero-shot 结果和超长输入中间截断策略，报告需说明模型上下文限制及截断方式。",
    "sourceUrls": [
      "https://github.com/THUDM/LongBench/tree/main/LongBench#data-format",
      "https://github.com/THUDM/LongBench/tree/main/LongBench"
    ]
  },
