  "researchStatus": "pass-with-limitations",
  "officialDefinition": {
    "summary": "以代理脚本、议会讲话和财报电话会的英语转录错误率加权衡量语音识别，区分批量与流式接口。",
    "task": "把英语音频转成逐字文本；与人工核对参考转录统一规范化后计算替换、插入和删除错误。",
    "sourceUrls": [
      "https://artificialanalysis.ai/methodology/speech-to-text"
    ]
  },
  "taskContract": {
    "input": "三套英语音频，约 8 小时；支持提示的接口要求只转录说出的内容。",
    "output": "批量接口返回转录；流式接口返回可修改 partial 与确认 final，分别计算相应 WER。",
    "environment": "直接调用 model-provider API。batch 默认处理 Earnings22 整段，受限时从约9分钟分块缩至约30秒；stream 通常约30秒分块、部分配置整段，20ms 实时送音频或遵循公开配置。",
    "sourceUrls": [
      "https://artificialanalysis.ai/methodology/speech-to-text"
    ]
  },
  "dataProfile": {
    "summary": "当前 1,103 音频样本由私有 AgentTalk 469 条和两套公开 test 清洗转录 634 条组成；官方规模约 8 小时，不代表三套原始语料全量。",
    "disclosure": "partial",
    "scale": [
      "AA-AgentTalk｜50%：469 条，8–109 秒，约250分钟；参与者朗读为语音代理场景设计的脚本，涵盖6内容类别、17口音组和8说话风格，不是自然交互日志。",
      "VoxPopuli-Cleaned-AA｜25%：628 条英语欧洲议会片段，约5–38秒；固定 JSONL 实读628行，duration合计7122.378375秒（约118.7分钟）。",
      "Earnings22-Cleaned-AA｜25%：6 段公司财报电话会议，约14–22分钟；固定 JSONL 实读6行，duration合计6895秒（约114.9分钟）。"
    ],
    "splits": [
      "AgentTalk：proprietary held-out。",
      "VoxPopuli、Earnings22：各自 default 配置 / test split，清洗转录发布版本1.0。",
      "历史 AMI SDM：Single Distant Microphone（单远场麦克风），不是所有多通道音频；未确认 AA 旧版子集等于上游完整 sdm/test。"
    ],
    "fields": [
      "id、duration、transcript、language、url、dataset、file_name；VoxPopuli另有gender。"
    ],
    "files": [
      "voxpopuli_cleaned_aa_v1.jsonl，固定07adf4a，280621字节。",
      "earnings22_cleaned_aa_v1.jsonl，固定5999936，93751字节。",
      "两个仓库另有 audio/；本轮只读取数据卡、索引和JSONL，未下载或听辨音频。"
    ],
